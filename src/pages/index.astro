---
import Layout from '../layouts/Layout.astro';
import { links, email, stack, projects, lead, bio } from '../data/site';

const c = (name: string) => `var(--${name})`;
---
<Layout>
  <div class="wrap layout">
    <main>
      <section class="hero" id="top" data-observe aria-labelledby="hero-title">
        <div class="hero-text">
          <p class="file" style="color: var(--faint)">// andycodes.dev</p>
          <h1 id="hero-title">Hi, I'm Andy.<br />I write code.</h1>
          <p class="lead">{lead}</p>
          <div class="actions">
            <a class="btn btn-primary" href="#projects">See projects</a>
            <a class="btn" href="#contact">Get in touch</a>
          </div>
        </div>

        <figure class="code">
          <div class="code-window">
            <div class="code-tab">andy.ts</div>
<pre><code><span class="ln" aria-hidden="true">1</span><span style="color: var(--lilac)">function</span> <span style="color: var(--teal)">andy</span><span style="color: var(--amber)">{'() {'}</span>
<span class="ln" aria-hidden="true">2</span>  <span style="color: var(--coral)">const</span> <span style="color: var(--amber)">idea = await coffee()</span>;
<span class="ln" aria-hidden="true">3</span>  <span style="color: var(--lilac)">return</span> <span style="color: var(--teal)">build(idea)</span>;
<span class="ln" aria-hidden="true">4</span><span style="color: var(--amber)">{'}'}</span></code></pre>
          </div>
          <figcaption>// the logo is the minimap of this function</figcaption>
        </figure>
      </section>

      <section id="projects" data-observe aria-labelledby="projects-title">
        <p class="file" style="color: var(--coral)">projects.rs</p>
        <h2 id="projects-title">Projects</h2>
        <div class="grid">
          {projects.map((p, i) => (
            <article class="card">
              <div class="bars" aria-hidden="true">
                <span style={`width: ${24 + ((i * 7) % 20)}px; background: ${c(p.color)}`}></span>
                <span style={`width: ${14 + ((i * 11) % 28)}px; background: ${c(p.accent)}`}></span>
              </div>
              <span class="mono" style={`font-size: 13px; color: ${c(p.color)}`}>{p.type}</span>
              <h3>{p.name}</h3>
              <p>{p.description}</p>
              <div class="links">
                {p.repoUrl && <a href={p.repoUrl}>Code</a>}
                {p.liveUrl && <a href={p.liveUrl}>Live</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about" data-observe aria-labelledby="about-title">
        <div>
          <p class="file" style="color: var(--lilac)">about.md</p>
          <h2 id="about-title">About</h2>
        </div>
        <div>
          <p class="bio">{bio}</p>
          <p class="file" style="margin: 28px 0 12px; font-size: 13px; color: var(--muted)">// stack</p>
          <ul class="chips">{stack.map((s) => <li>{s}</li>)}</ul>
        </div>
      </section>

      <section id="contact" data-observe aria-labelledby="contact-title" style="padding-bottom: 88px">
        <p class="file" style="color: var(--amber)">contact.sh</p>
        <h2 id="contact-title">Say hi</h2>
        <div class="terminal">
          <p style="margin: 0 0 14px"><span style="color: var(--teal)">$</span> contact --andy</p>
          <dl>
            <dt>github</dt><dd><a href={links.github}>github.com/andycodesbugs</a></dd>
            <dt>x</dt><dd><a href={links.x}>x.com/andycodesbugs</a></dd>
            {email && (<><dt>email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></>)}
          </dl>
        </div>
      </section>
    </main>

    <aside class="rail" aria-label="Page minimap">
      <nav aria-label="Page minimap">
        <a href="#top" data-section="top" aria-label="Jump to the top">
          <span class="row"><span style="width: 22px; background: var(--lilac)"></span><span style="width: 20px; background: var(--teal)"></span><span style="width: 9px; background: var(--amber)"></span></span>
          <span class="row in"><span style="width: 16px; background: var(--coral)"></span><span style="width: 30px; background: var(--amber)"></span></span>
          <span class="row in"><span style="width: 22px; background: var(--lilac)"></span><span style="width: 18px; background: var(--teal)"></span></span>
          <span class="row"><span style="width: 9px; background: var(--amber)"></span></span>
        </a>
        <a href="#projects" data-section="projects" aria-label="Jump to projects">
          <span class="row"><span style="width: 26px; background: var(--coral)"></span><span style="width: 26px; background: var(--teal)"></span><span style="width: 26px; background: var(--amber)"></span></span>
          <span class="row"><span style="width: 26px; background: var(--lilac)"></span><span style="width: 26px; background: var(--teal)"></span><span style="width: 26px; background: var(--coral)"></span></span>
        </a>
        <a href="#about" data-section="about" aria-label="Jump to about">
          <span style="width: 60px; background: var(--lilac)"></span>
          <span style="width: 80px; background: var(--line-strong)"></span>
          <span style="width: 50px; background: var(--line-strong)"></span>
        </a>
        <a href="#contact" data-section="contact" aria-label="Jump to contact">
          <span class="row"><span style="width: 8px; background: var(--teal)"></span><span style="width: 40px; background: var(--amber)"></span></span>
          <span style="width: 56px; background: var(--line-strong)"></span>
        </a>
      </nav>
    </aside>
  </div>
</Layout>
